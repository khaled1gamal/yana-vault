# =============================================================================
# Digital Time Capsule — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or service-account JSON files.
# =============================================================================

# --- Firebase client (safe to expose in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 site key). Leave empty to skip in local development.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Public capsule id used by the client to target this family capsule.
NEXT_PUBLIC_CAPSULE_ID=yana-vault

# Public display fallback (real values live in Firestore settings/config).
NEXT_PUBLIC_RECIPIENT_FIRST_NAME=Yana

# --- Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n escaped newlines, or wrap in quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Access bootstrap (server-side role assignment) ---
# Comma-separated emails that receive the ADMIN role on first verified login.
ADMIN_EMAILS=you@example.com
# The recipient's email. Assigned RECIPIENT role on first verified login.
RECIPIENT_EMAIL=recipient@example.com
# Optional comma-separated family emails. Additional family members can also
# be added later from the admin screen (stored in Firestore, not env).
FAMILY_EMAILS=

# Seed values used only when an admin initializes the capsule (server-side).
# Do not treat these as the unlock source of truth after initialization.
SEED_BIRTH_DATE=2011-01-01
SEED_TIMEZONE=Asia/Manila
SEED_CAPSULE_TITLE=Yana's Digital Time Capsule
SEED_RECIPIENT_NAME=Yana

# Optional: Firebase Auth authorized Google OAuth client is configured in console.
# Session cookie lifetime in milliseconds (default 5 days).
SESSION_EXPIRES_MS=432000000
